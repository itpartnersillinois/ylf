<!doctype html>
<html lang="en">
    <head>
        {% render 'renders/head' %}
    </head>
    <body class="{{ bodyClass }}">
         <ilw-page>
            {% render 'renders/header' with pagelist as pagelist %}
                    <div class="bannerPhoto homepage" style="background-image: url({{ headerImage }});"> </div>
                    {{ circles | circleFormat }}
                    <div class="main">
                        <main>
                            <ilw-content>
                            <h1>{{ pageTitle }} </h1>
                            {{ content }}
                            </ilw-content>
                        </main>
                        <aside>
                            <ilw-content transparent="true">
                            {% render 'renders/sidebar' %} 
                            </ilw-content>
                        </aside>
                    </div>
                </main>
                    
            <ilw-footer slot="footer">
                {% render 'renders/footer' %}
            </ilw-footer>
         </ilw-page>
    </body>
</html>